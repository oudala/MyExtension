{
  "manifest_version": 3,
  "name": "LinkDrop",
  "version": "1.0.0",
  "description": "Share links instantly with friends",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "scripting",
    "commands",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://api.linkdrop.app/*",
    "http://localhost:5000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [{
    "resources": ["icons/*", "images/*"],
    "matches": ["<all_urls>"]
  }],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "88",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LinkDrop",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open LinkDrop popup"
    },
    "quick_share_1": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "Quick share to shortcut 1"
    },
    "quick_share_2": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "Command+Shift+2"
      },
      "description": "Quick share to shortcut 2"
    },
    "quick_share_3": {
      "suggested_key": {
        "default": "Ctrl+Shift+3",
        "mac": "Command+Shift+3"
      },
      "description": "Quick share to shortcut 3"
    }
  }
}